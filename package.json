{
  "name": "chess-vanguard",
  "productName": "Chess Vanguard",
  "version": "1.1.0",
  "description": "Chess Vanguard — Offline-first chess academy, puzzles and engine play. © 2026 Malek Hassan Ashour.",
  "main": "build/main.js",
